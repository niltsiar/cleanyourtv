<?xml version="1.0" encoding="utf-8"?>
<!-- Keys only: no accessibilityEventTypes (0), so the system never calls into the launcher for accessibility events.
     Key filtering depends only on flagRequestFilterKeyEvents and canRequestFilterKeyEvents, not on the event types.
     stock_home_redirect, power_on_home and "front:" app_keys are the exception: the service adds typeWindowStateChanged at runtime. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/key_service_description" />
