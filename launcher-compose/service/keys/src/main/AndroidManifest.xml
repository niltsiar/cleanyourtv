<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- One accessibility service for the remote's buttons that the stock launcher used to answer. directBootAware:
             Android 11 skips a service that is not while the user is still locked at boot, and on TCL G03 firmware never
             binds it after the unlock. -->
        <service
            android:name=".KeyService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/key_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>

        <!-- stock_home_redirect at boot: the service opens this invisible activity once, so the screen behind it sends a
             window event when it closes. -->
        <activity
            android:name=".ProbeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
