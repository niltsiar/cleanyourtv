<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- One accessibility service for the remote's buttons that the stock launcher used to answer. directBootAware:
             Android 11 skips a service that is not while the user is still locked at boot, and on TCL G03 firmware never
             binds it after the unlock. -->
        <service
            android:name=".KeyService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/key_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>

        <!-- Bound again by the system after a force stop, which restarts Home on firmware that kills third-party apps
             (TCL tc8000_ay30a2). It reads no notification.
             cmd notification allow_listener dev.niltsiar.tvhome/.service.keys.GuardRevival -->
        <service
            android:name=".GuardRevival"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/key_service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The opt-in to leave the key service while the screen is off; only the adb shell holds the permission. -->
        <receiver
            android:name=".GuardConfig"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="${applicationId}.GUARD" />
            </intent-filter>
        </receiver>

        <!-- stock_home_redirect at boot: the service opens this invisible activity once, so the screen behind it sends a
             window event when it closes. -->
        <activity
            android:name=".ProbeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
