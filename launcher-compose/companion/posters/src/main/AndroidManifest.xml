<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Home declares the same permission, so either app can be installed first. -->
    <permission
        android:name="dev.niltsiar.tvhome.posters.permission.READ_POSTERS"
        android:protectionLevel="signature" />

    <!-- Cleartext is on for the app because a network security config cannot say "private addresses only": the code
         allows http only for a request with lan=1, whose every address must be private. -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_posters"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true">

        <!-- Exported to Home, another package. The signature permission keeps out every app signed with another key, also
             from watching or notifying its changes; PosterProvider checks the caller's key again in openFile. -->
        <provider
            android:name=".PosterProvider"
            android:authorities="dev.niltsiar.tvhome.posters"
            android:exported="true"
            android:permission="dev.niltsiar.tvhome.posters.permission.READ_POSTERS"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
